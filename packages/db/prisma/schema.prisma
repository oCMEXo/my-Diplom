generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  owner
  editor
  viewer
}

enum FileKind {
  code
  doc
  board
}

enum EmailTokenKind {
  verify
  reset
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  isGuest         Boolean   @default(false) @map("is_guest")
  // Set once the person opened the link from the confirmation email (or reset the password by email).
  emailVerifiedAt DateTime? @map("email_verified_at")
  // The GitHub account this user signs in with, if any.
  githubId        String?   @unique @map("github_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  usageEvents   UsageEvent[]
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  messages      Message[]
  fileVersions  FileVersion[]
  classes       Classroom[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// Usage statistics, kept on this server only and deleted after 180 days (see apps/api/src/lib/usage.ts).
model UsageEvent {
  id        String   @id @default(uuid())
  kind      String
  userId    String?  @map("user_id")
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
  @@map("usage_events")
}

// One-time links sent by email: confirming the address or setting a new password.
model EmailToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model Project {
  id         String      @id @default(uuid())
  name       String
  ownerId    String      @map("owner_id")
  inviteCode String      @unique @map("invite_code")
  inviteRole ProjectRole @default(editor) @map("invite_role")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Set when the project is linked to a GitHub repository (import or first push).
  githubOwner  String? @map("github_owner")
  githubRepo   String? @map("github_repo")
  githubBranch String? @map("github_branch")
  // A student's own copy of a class task; null for ordinary projects.
  classId      String? @map("class_id")

  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members      ProjectMember[]
  files        File[]
  messages     Message[]
  classroom    Classroom?      @relation("ClassCopies", fields: [classId], references: [id], onDelete: SetNull)
  taughtAsTask Classroom?      @relation("ClassTask")

  @@index([classId])
  @@map("projects")
}

// A class: students open its link and each gets their own copy of the teacher's task project, with the
// teacher added as an editor. Deleting the class keeps the students' copies.
model Classroom {
  id            String   @id @default(uuid())
  name          String
  teacherId     String   @map("teacher_id")
  taskProjectId String   @unique @map("task_project_id")
  joinCode      String   @unique @map("join_code")
  createdAt     DateTime @default(now()) @map("created_at")

  teacher User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  task    Project   @relation("ClassTask", fields: [taskProjectId], references: [id], onDelete: Cascade)
  copies  Project[] @relation("ClassCopies")

  @@index([teacherId])
  @@map("classes")
}

model ProjectMember {
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(editor)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model File {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  path        String
  // The GitHub branch this file belongs to ("" for projects without a repository). Only the
  // project's active branch is shown, so every branch keeps its own files and edits.
  branch      String    @default("")
  type        FileKind  @default(code)
  language    String?
  yjsState    Bytes?    @map("yjs_state")
  // Git blob SHA of the content as of the last sync with GitHub; lets a push see what changed.
  sourceSha   String?   @map("source_sha")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // A deleted file stays in the project's trash: its path moves under ".trash/<id>/" and the original is kept here.
  deletedAt   DateTime? @map("deleted_at")
  trashedPath String?   @map("trashed_path")

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions FileVersion[]

  @@unique([projectId, branch, path])
  @@map("files")
}

// Earlier states of a code or Markdown file, taken by the sync server while people edit.
model FileVersion {
  id        String   @id @default(uuid())
  fileId    String   @map("file_id")
  // Plain text rather than Yjs state: a version is only ever shown or put back as text (a restore
  // is a new edit, not a rollback of the CRDT), and text has no edit history inside, so it is smaller.
  content   String
  // Bytes of the UTF-8 text, so the list does not have to load the contents.
  size      Int
  // Whose edit was being saved when the snapshot was taken; null once that account is gone.
  authorId  String?  @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  file   File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([fileId, createdAt])
  @@map("file_versions")
}

model Message {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
  @@map("messages")
}
