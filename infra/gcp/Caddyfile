{$SITE_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		encode zstd gzip
		reverse_proxy api:3001
	}

	@collab path /collab /collab/*
	handle @collab {
		uri strip_prefix /collab
		reverse_proxy collab:1234
	}

	@terminal path /terminal /terminal/*
	handle @terminal {
		uri strip_prefix /terminal
		reverse_proxy runner:3003
	}

	@preview {
		method GET
		path / /join/*
		header_regexp User-Agent (?i)(telegrambot|whatsapp|facebookexternalhit|twitterbot|slackbot|discordbot|vkshare|linkedinbot|viber|skypeuripreview)
	}
	handle @preview {
		rewrite * /preview{path}
		reverse_proxy api:3001
	}

	handle {
		root * /srv/web
		@fresh path / /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @fresh Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
