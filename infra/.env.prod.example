# Hostnames that point at the EC2 instance. Without a domain, sslip.io works:
#   API_DOMAIN=api.203-0-113-10.sslip.io   COLLAB_DOMAIN=collab.203-0-113-10.sslip.io
API_DOMAIN=api.example.com
COLLAB_DOMAIN=collab.example.com

# RDS PostgreSQL. Append ?sslmode=require&schema=public
DATABASE_URL=postgresql://collab:CHANGE_ME@your-db.xxxxxxxx.eu-central-1.rds.amazonaws.com:5432/collab?schema=public&sslmode=require

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# Origin(s) the web app is served from (the CloudFront domain), comma-separated.
CORS_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net

# Without these two every limit is off (that is the default for development).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
# Caddy is in front, so the real client address is in X-Forwarded-For.
TRUST_PROXY=true

# Anyone with an account can run code unless this is set. Choose a long random value,
# or set RUN_ENABLED=false to switch running code and the terminal off.
RUN_ACCESS_CODE=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Email for confirming addresses and resetting passwords (any SMTP service).
SMTP_URL=smtp://user:CHANGE_ME@smtp.example.com:587
MAIL_FROM=Collab <no-reply@example.com>

# Optional "Continue with GitHub" (OAuth app callback: https://<API_DOMAIN>/auth/github/callback).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# API_PUBLIC_URL=https://api.example.com

# "runsc" runs code under gVisor; install it on the host first (see docs/deploy-gcp.md).
# SANDBOX_RUNTIME=runsc
