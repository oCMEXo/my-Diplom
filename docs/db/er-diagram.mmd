erDiagram
  users ||--o{ refresh_tokens : "sign-in sessions"
  users ||--o{ projects : "owns"
  users ||--o{ project_members : "takes part"
  projects ||--o{ project_members : "members"
  projects ||--o{ files : "contains"
  files ||--o{ file_versions : "versions"
  users |o--o{ file_versions : "version author"
  projects ||--o{ messages : "chat"
  users ||--o{ messages : "writes"
  users ||--o{ email_tokens : "email links"
  users ||--o{ classes : "teaches"
  projects ||--o| classes : "task of"
  classes |o--o{ projects : "student copies"
  users |o--o{ usage_events : "usage"

  users {
    text id PK "UUID"
    text email UK "lower case"
    text name
    text password_hash "Argon2id"
    boolean is_guest
    timestamp email_verified_at "NULL"
    text github_id UK "NULL"
    timestamp created_at
  }
  refresh_tokens {
    text id PK "UUID"
    text user_id FK
    text token_hash "SHA-256"
    timestamp expires_at
    timestamp created_at
  }
  projects {
    text id PK "UUID"
    text name
    text owner_id FK
    text invite_code UK
    ProjectRole invite_role
    text github_owner "NULL"
    text github_repo "NULL"
    text github_branch "NULL"
    text class_id FK "NULL"
    timestamp created_at
  }
  project_members {
    text project_id PK, FK
    text user_id PK, FK
    ProjectRole role
  }
  files {
    text id PK "UUID"
    text project_id FK "UK1"
    text branch "UK1"
    text path "UK1"
    FileKind type
    text language "NULL"
    bytea yjs_state "NULL"
    text source_sha "NULL"
    timestamp updated_at
    timestamp deleted_at "NULL"
    text trashed_path "NULL"
  }
  file_versions {
    text id PK "UUID"
    text file_id FK
    text content
    integer size
    text author_id FK "NULL"
    timestamp created_at
  }
  messages {
    text id PK "UUID"
    text project_id FK
    text author_id FK
    text body
    timestamp created_at
  }
  email_tokens {
    text id PK "UUID"
    text user_id FK
    EmailTokenKind kind
    text token_hash UK "SHA-256"
    timestamp expires_at
    timestamp created_at
  }
  classes {
    text id PK "UUID"
    text name
    text teacher_id FK
    text task_project_id FK "UK"
    text join_code UK
    timestamp created_at
  }
  usage_events {
    text id PK "UUID"
    text kind
    text user_id FK "NULL"
    text project_id "NULL"
    timestamp created_at
  }
