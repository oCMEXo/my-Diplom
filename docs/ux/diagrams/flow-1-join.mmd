flowchart TD
  A([Guest got a link]) --> C{Link valid?}
  C -- no --> E1[/Error: link not valid, screen 4/]
  C -- yes --> D{Already signed in?}
  D -- yes --> J[Project open]
  D -- no --> F[Invitation page, screen 3]
  F --> H{Name entered?}
  H -- no --> E2[/Button disabled/] --> F
  H -- yes --> J
  J --> K{Role}
  K -- viewer --> R([Read only, screen 5])
  K -- editor --> L[Edits the file with everyone]
  L --> M{Connected?}
  M -- yes --> Z([Synced])
  M -- no --> N[/Connecting… or Offline, screen 8/]
  N --> O[Keeps typing] --> P[Back online, edits merged, screen 9] --> Z
