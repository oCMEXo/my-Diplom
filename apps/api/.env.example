# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Limits per person (these are the defaults).
# MAX_PROJECTS_PER_USER=100
# MAX_FILES_PER_PROJECT=2000
# RUNS_PER_MINUTE=20
